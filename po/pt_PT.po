msgstr "O fwmanager precisa do libadwaita 1.5 ou superior, mas este sistema tem {found}. Use o Ubuntu 24.04, o Fedora 40 ou posterior. A linha de comandos (fwmanager-cli) funciona em sistemas mais antigos."

msgid "fwmanager switches profile by itself when you change network. Use Test before applying anything new, and Rules for your own settings."
msgstr "O fwmanager muda de perfil sozinho quando muda de rede. Use Testar antes de aplicar algo novo e Regras para as suas definições."

msgid "libvirt manages its own rules (they are left untouched)."
msgstr "O libvirt gere as suas próprias regras (ficam intocadas)."

msgid "list available profiles"
msgstr "listar os perfis disponíveis"

msgid "manage the network to profile mapping"
msgstr "gerir a associação de redes a perfis"

msgid "none"
msgstr "nenhum"

msgid "not applicable"
msgstr "não aplicável"

msgid "only accepts connections from the local network"
msgstr "só aceita ligações da rede local"

msgid "only accepts connections from {networks}"
msgstr "só aceita ligações de {networks}"

msgid "only analyse the rules, change nothing"
msgstr "só analisar as regras, sem alterar nada"

msgid "opens {services}"
msgstr "abre {services}"

msgid "profile name"
msgstr "nome do perfil"

msgid "revert the pending change"
msgstr "reverter a alteração pendente"

msgid "show the firewall state"
msgstr "mostrar o estado da firewall"

msgid "starts answering ping"
msgstr "passa a responder a ping"

msgid "stops answering ping"
msgstr "deixa de responder a ping"

msgid "turns mDNS off"
msgstr "desliga o mDNS"

msgid "turns mDNS on"
msgstr "liga o mDNS"

