#!/bin/sh
# Removes the fwmanager package for everyone: what the Uninstall button in Settings and
# `fwmanager-cli uninstall` run (as root, through pkexec). The package's own scripts undo its
# changes to ufw first. Same as: sudo apt purge fwmanager
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
DEBIAN_FRONTEND=noninteractive
export PATH DEBIAN_FRONTEND

if [ "$(id -u)" -ne 0 ]; then
    echo "uninstall: must run as root (use sudo)" >&2
    exit 1
fi
if command -v apt-get >/dev/null 2>&1; then
    # Waits a little if another installation (an automatic update, say) holds the lock.
    exec apt-get purge -y -q -o DPkg::Lock::Timeout=120 fwmanager
fi
exec dpkg --purge fwmanager
